{
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/last-commit",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/Last%20Commit%C2%B7%E6%97%A9%E7%9D%A1%E4%BD%9C%E6%81%AF%E7%B3%BB%E7%BB%9F.html"
    },
    {
      "source": "/last-commit",
      "destination": "/Last%20Commit%C2%B7%E6%97%A9%E7%9D%A1%E4%BD%9C%E6%81%AF%E7%B3%BB%E7%BB%9F.html"
    }
  ]
}
